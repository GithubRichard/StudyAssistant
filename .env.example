# 复制为 .env 后填写：cp .env.example .env
# 说明：不填的项留空即可；至少填一家大模型 key，服务才能批改作业

# ---------- 大模型密钥（config.yaml 里用 ${XXX} 引用）----------
QWEN_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=

# ---------- 微信小程序（正式环境必填）----------
# appid 与 miniprogram/project.config.json 保持一致
WECHAT_APPID=wx379a065a538ad7b4
# 微信公众平台 → 开发 → 开发管理 → 开发设置 → 小程序密钥
WECHAT_SECRET=
# 订阅消息模板 ID（可选）
WECHAT_TEMPLATE_ID=
