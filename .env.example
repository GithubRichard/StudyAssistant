# 复制为 .env 后填写：cp .env.example .env
# 注意：Docker Compose 的环境变量在创建容器时注入，改完 .env 需要
#       `docker compose up -d --force-recreate`，仅 restart 不会更新。

# ---------- 监听地址（调试用直连 IP 时才需要）----------
# 默认 127.0.0.1：仅本机可达，由反向代理对外（安全）
# 设为 0.0.0.0：可直接用 http://服务器IP:8000 访问；
#   必须配合云防火墙限制来源 IP，并务必配置 WECHAT_SECRET
# APP_HOST=0.0.0.0

# ---------- Hermes Agent API（服务端内部调用，不要下发给小程序）----------
# 默认仅本机可达；远程部署时通常由应用容器连接宿主机 Hermes
HERMES_BASE_URL=http://127.0.0.1:8642
# Hermes 的 API Server 密钥（API_SERVER_KEY），必须设置
HERMES_API_KEY=

# ---------- 网页版账号（不在 .env 中配置）----------
# 网页版登录用「用户名 + 密码」，账号名单写在 config.yaml 的 web.users 里，
# 本文件不涉及网页账号；web.users 为空时网页登录接口一律拒绝。
# 生成账号（密码只存 pbkdf2 哈希，不写明文），把输出粘到 config.yaml：
#   python3 scripts/make_web_user.py --username leo --display-name Leo
# 注意：http 直连时令牌明文传输，建议只在可信网络使用，并配合防火墙限制来源 IP。

# ---------- 微信小程序（正式环境必填）----------
WECHAT_APPID=wx379a065a538ad7b4
# 微信公众平台 → 开发管理 → 开发设置 → 小程序密钥
WECHAT_SECRET=
WECHAT_TEMPLATE_ID=

# ---------- legacy 直连模型（仅 engine.mode=legacy 时使用）----------
# Hermes 模式下不要填写，底层模型由 Hermes 自己配置
QWEN_API_KEY=
GLM_API_KEY=

# ---------- 日志 ----------
# 业务日志级别：DEBUG / INFO / WARNING，默认 INFO；改完需重建容器
#LOG_LEVEL=INFO
# 临时记录模型的思考过程（reasoning_content）到 docker 日志：1=开，0=关（默认关）。
# 分析判题问题时打开，用完关掉并重建容器。不进数据库、不进批改结果。
# 查看：docker logs <容器名> | grep -A 200 模型思考过程
#SA_DEBUG_THINKING=1
