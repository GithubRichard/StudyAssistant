# 复制为 .env 后填写：cp .env.example .env
# 注意：Docker Compose 的环境变量在创建容器时注入，改完 .env 需要
#       `docker compose up -d --force-recreate`，仅 restart 不会更新。

# ---------- 监听地址（调试用直连 IP 时才需要）----------
# 默认 127.0.0.1：仅本机可达，由反向代理对外（安全）
# 设为 0.0.0.0：可直接用 http://服务器IP:8000 访问；
#   必须配合云防火墙限制来源 IP，并务必配置 WECHAT_SECRET
# APP_HOST=0.0.0.0

# ---------- Hermes Agent API（服务端内部调用，不要下发给小程序）----------
# 默认仅本机可达；远程部署时通常由应用容器连接宿主机 Hermes
HERMES_BASE_URL=http://127.0.0.1:8642
# Hermes 的 API Server 密钥（API_SERVER_KEY），必须设置
HERMES_API_KEY=

# ---------- 网页版访问密码（用 IP 直连时必填）----------
# 浏览器打开 http://服务器IP:8000/ 输入该密码即可登录，无需小程序备案。
# 未配置时网页登录接口一律拒绝；请务必设置足够长的随机密码。
# 注意：http 直连时令牌明文传输，建议只在可信网络使用，并配合防火墙限制来源 IP。
WEB_PASSWORD=

# ---------- 微信小程序（正式环境必填）----------
WECHAT_APPID=wx379a065a538ad7b4
# 微信公众平台 → 开发管理 → 开发设置 → 小程序密钥
WECHAT_SECRET=
WECHAT_TEMPLATE_ID=

# ---------- legacy 直连模型（仅 engine.mode=legacy 时使用）----------
# Hermes 模式下不要填写，底层模型由 Hermes 自己配置
QWEN_API_KEY=
GLM_API_KEY=
