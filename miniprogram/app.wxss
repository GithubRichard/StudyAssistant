/** 全局通用样式 **/
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.container {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
button[type="primary"] {
  background: #07c160 !important;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 120rpx;
}
