/** 全局通用样式：深翠绿 + 暖白，阅读优先 **/
page {
  background: #F6F7F3;
  color: #20352F;
  font-size: 28rpx;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;
}
.container { padding: 24rpx 24rpx 60rpx; }

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 107, 86, 0.06);
}

.sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #20352F;
  margin-bottom: 12rpx;
}
.muted { color: #66766F; font-size: 26rpx; }
.empty { text-align: center; color: #66766F; margin-top: 120rpx; line-height: 1.9; }

button[type="primary"] {
  background: #126B56 !important;
  border-radius: 16rpx;
  font-weight: 600;
}
button[type="primary"][disabled] { background: #A9C6BC !important; }
button { border-radius: 16rpx; }

/* 任务状态标签：文字 + 颜色，不单靠颜色传达 */
.status-pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.pill-pending { background: #E8EDF5; color: #5A6D8C; }
.pill-running { background: #D5EDE4; color: #126B56; }
.pill-done { background: #DDEEDF; color: #237A57; }
.pill-waiting { background: #F7EDD2; color: #916400; }
.pill-failed { background: #F7DDDD; color: #BA4343; }
.pill-interrupted { background: #EDEAE4; color: #737B80; }

/* 题目五态标签 */
.qtag { padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }
.qtag-correct { background: #DDEEDF; color: #237A57; }
.qtag-wrong { background: #F7DDDD; color: #BA4343; }
.qtag-unanswered { background: #F7EDD2; color: #916400; }
.qtag-uncertain { background: #E8EDF5; color: #5A6D8C; }
.qtag-unprocessed { background: #EDEAE4; color: #737B80; }
