<view class="container">
  <view wx:if="{{tasks.length === 0}}" class="empty">还没有批改记录，去拍第一张作业吧 📷</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card row-card" bindtap="goResult" data-id="{{item.id}}">
    <view>
      <text class="t">{{item.subject}}</text>
      <text class="time">{{item.time}}</text>
    </view>
    <text class="st st-{{item.status}}">{{statusText[item.status]}}</text>
  </view>
</view>
