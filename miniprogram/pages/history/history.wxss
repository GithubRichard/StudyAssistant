.row-card { display: flex; justify-content: space-between; align-items: flex-start; }
.row-main { flex: 1; padding-right: 16rpx; }
.t { font-size: 30rpx; font-weight: 600; display: block; color: #20352F; }
.time { color: #8A968F; font-size: 24rpx; display: block; margin-top: 8rpx; }
.summary {
  display: block;
  color: #4A5B55;
  font-size: 25rpx;
  margin-top: 10rpx;
  line-height: 1.6;
}
.miss-note { display: block; color: #916400; font-size: 24rpx; margin-top: 8rpx; }
