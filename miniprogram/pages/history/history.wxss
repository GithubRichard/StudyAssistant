.row-card { display: flex; justify-content: space-between; align-items: center; }
.t { font-size: 32rpx; font-weight: bold; display: block; }
.time { color: #999; font-size: 24rpx; display: block; margin-top: 8rpx; }
.st { font-size: 26rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.st-pending, .st-grading { background: #fff7e6; color: #d48806; }
.st-done { background: #e6f9ee; color: #07c160; }
.st-failed { background: #fdecec; color: #fa5151; }
