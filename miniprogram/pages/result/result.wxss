.disclaimer {
  background: #F7EDD2;
  color: #916400;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 25rpx;
}

.head-row { display: flex; justify-content: space-between; align-items: center; }
.head-title { font-size: 30rpx; font-weight: 600; }

.loading { text-align: center; }
.state-line { display: block; font-size: 32rpx; font-weight: 600; color: #126B56; margin-bottom: 12rpx; }
.state-line.err { color: #BA4343; }
.loading .muted, .card .muted { display: block; margin-top: 8rpx; }

.warn { background: #FBF3E4; color: #916400; }

.stat-row { display: flex; flex-wrap: wrap; margin: 8rpx 0 12rpx; }
.stat { width: 20%; text-align: center; }
.stat-n { display: block; font-size: 40rpx; font-weight: 600; color: #20352F; }
.stat-n.ok { color: #237A57; }
.stat-n.bad { color: #BA4343; }
.stat-n.wait { color: #916400; }
.stat-n.info { color: #5A6D8C; }
.stat-l { font-size: 22rpx; color: #66766F; }

.q-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.q-no { font-size: 30rpx; font-weight: 600; }
.q-src { display: block; color: #8A968F; font-size: 24rpx; margin-bottom: 8rpx; }
.q-row { margin: 10rpx 0; line-height: 1.65; }
.k { color: #66766F; }
.ans { color: #126B56; font-weight: 600; }
.miss { display: block; color: #916400; margin: 6rpx 0; line-height: 1.7; }
.body { display: block; color: #3C4B45; line-height: 1.8; white-space: pre-wrap; }

.explain { background: #F7F9F6; border-radius: 14rpx; padding: 20rpx; margin: 16rpx 0; }
.step { margin: 8rpx 0; line-height: 1.7; }
.q button { margin-top: 12rpx; }

.delivery-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F2EF;
}
.delivery-row:last-child { border-bottom: none; }
.d-label { color: #3C4B45; }
.d-status { font-weight: 600; font-size: 26rpx; }
.d-generated, .d-committed, .d-sent { color: #237A57; }
.d-skipped { color: #737B80; }
.d-not_configured { color: #916400; }
.d-failed { color: #BA4343; }

.artifact-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F2EF;
}
.artifact-row:last-child { border-bottom: none; }
.link { color: #126B56; font-weight: 600; }

.run-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  background: #F7F9F6;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 27rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.grid { display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.thumb-wrap { position: relative; width: 180rpx; height: 180rpx; margin: 0 14rpx 14rpx 0; }
.thumb { width: 180rpx; height: 180rpx; border-radius: 14rpx; background: #EFF2EF; }
.thumb-del {
  position: absolute; right: -8rpx; top: -8rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #20352F; color: #fff; text-align: center; line-height: 40rpx; font-size: 26rpx;
}
.thumb.add {
  border: 2rpx dashed #A9C6BC;
  display: flex; align-items: center; justify-content: center;
  color: #126B56; font-size: 46rpx; background: #FBFCFA;
}
