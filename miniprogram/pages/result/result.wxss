.disclaimer {
  background: #fff7e6;
  color: #d48806;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}
.loading { text-align: center; color: #666; padding: 80rpx 0; }
.loading .spin { font-size: 60rpx; display: block; margin-bottom: 20rpx; }
.err-title { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 12rpx; }
.err-msg { color: #999; display: block; margin-bottom: 24rpx; }
.summary { text-align: center; }
.score { font-size: 64rpx; font-weight: bold; color: #07c160; display: block; }
.score .total { font-size: 32rpx; color: #999; font-weight: normal; }
.summary-text { color: #666; display: block; margin-top: 12rpx; }
.q-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.q-no { font-size: 32rpx; font-weight: bold; }
.badge { padding: 6rpx 18rpx; border-radius: 20rpx; font-size: 24rpx; }
.badge.ok { background: #e6f9ee; color: #07c160; }
.badge.bad { background: #fdecec; color: #fa5151; }
.q-row { margin: 10rpx 0; line-height: 1.6; }
.k { color: #999; }
.ans { color: #07c160; font-weight: bold; }
.explain { background: #f8f8f8; border-radius: 12rpx; padding: 20rpx; margin: 16rpx 0; }
.step { margin: 8rpx 0; line-height: 1.7; }
.q button { margin-top: 8rpx; }
