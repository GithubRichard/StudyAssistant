<view class="container">
  <view class="card user">
    <text class="u-title">当前账号</text>
    <text class="u-id">{{openid || '未登录'}}</text>
    <button size="mini" bindtap="copyOpenid">复制 openid</button>
  </view>

  <view class="card">
    <view class="row">
      <text>剩余可用次数</text>
      <text class="big">{{remaining}}</text>
    </view>
  </view>

  <view class="card">
    <text class="sec-title">学习设置</text>
    <text class="muted">{{familyText}}</text>
    <button size="mini" type="primary" bindtap="goSettings">打开学习设置</button>
  </view>

  <view class="card">
    <text class="sec-title">学习记录同步</text>
    <text class="muted">{{gitText}}</text>
    <text class="muted" wx:if="{{lastSyncNote}}">{{lastSyncNote}}</text>
    <text class="muted">只提交本次归档的学习记录；原题资料不会上传，冲突时会停止上传并生成冲突记录。</text>
  </view>

  <view class="card">
    <text class="sec-title">执行引擎</text>
    <view class="row">
      <text>模式</text>
      <text class="muted">{{engineText}}</text>
    </view>
    <view class="row">
      <text>Hermes</text>
      <text class="status-pill {{hermesOk ? 'pill-done' : 'pill-waiting'}}">{{hermesText}}</text>
    </view>
    <text wx:if="{{error}}" class="muted">{{error}}</text>
    <text class="muted">「已配置」不等于「已就绪」：只有技能确实加载完成才会显示就绪。</text>
  </view>

  <view class="card">
    <text class="sec-title">交付能力</text>
    <view wx:for="{{delivery}}" wx:key="key" class="row">
      <text>{{item.label}}</text>
      <text class="status-pill {{item.enabled ? 'pill-done' : 'pill-interrupted'}}">{{item.enabled ? '已启用' : '未配置'}}</text>
    </view>
    <text class="muted">未启用的能力会在结果中标注为未配置，不会被模型自述替代。</text>
  </view>

  <view class="card" wx:if="{{limits}}">
    <text class="sec-title">限额</text>
    <view class="row"><text>单次图片上限</text><text class="muted">{{limits.max_assets_per_task}} 张</text></view>
    <view class="row"><text>单任务最多轮次</text><text class="muted">{{limits.max_runs_per_task}} 轮</text></view>
    <view class="row"><text>单轮执行上限</text><text class="muted">{{limits.max_task_minutes}} 分钟</text></view>
    <view class="row" wx:if="{{workspace}}"><text>学习工作区</text><text class="muted">{{workspace.dir}}</text></view>
  </view>

  <view class="card">
    <text class="sec-title">服务器地址</text>
    <view class="row"><text class="url">{{baseUrl}}</text></view>
    <button size="mini" bindtap="copyBaseUrl">复制</button>
    <text class="muted">小程序只连接本服务；Hermes 地址与密钥不会出现在前端。</text>
  </view>

  <button bindtap="relogin">重新登录</button>
</view>
