<view class="container">
  <view wx:if="{{mistakes.length === 0}}" class="empty">
    <text>错题本里还没有内容</text>
    <text class="muted">这里只保存你手动加入的题目；空不代表全部答对</text>
  </view>
  <view wx:for="{{mistakes}}" wx:key="id" class="card" bindtap="goTask" data-task="{{item.task_id}}">
    <view class="m-head">
      <text class="m-no">第 {{item.question_no}} 题</text>
      <text class="m-time">{{item.time}}</text>
    </view>
    <view wx:if="{{item.knowledge_point}}" class="m-kp">知识点：{{item.knowledge_point}}</view>
    <view wx:if="{{item.note}}" class="m-note">{{item.note}}</view>
    <text class="m-link">查看原批改 ›</text>
  </view>
</view>
